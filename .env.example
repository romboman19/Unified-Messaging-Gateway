# UMG Unified Messaging Gateway — example environment
# Copy this file to .env and replace placeholder values with strong secrets.

# Admin bootstrap password used only on first start / empty DB.
# After the admin user is created, rotate the password through the UI.
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-long-random-password

# Secrets for sessions and signed cookies (min 32 bytes).
SESSION_SECRET=change-me-to-a-long-random-session-secret-min-32-chars
COOKIE_SECRET=change-me-to-a-long-random-cookie-secret-min-32-chars

# Logging level: trace | debug | info | warn | error
LOG_LEVEL=info

# Database and Redis are configured in docker-compose.yml.
# Only override if you run services outside Compose.
# DATABASE_URL=postgresql://umg:umg@postgres:5432/umg?schema=public
# REDIS_URL=redis://redis:6379

# Optional: require HTTPS cookies in production
# SESSION_SECURE=true

# ─── Transport sidecar endpoints (TZ §21–§24) ─────────────────────────────────
# UMG treats the DBLtek / go-whatsapp-web-multidevice / signal-cli-rest-api
# services as private sidecars on the `transports` Docker network. The
# default Compose stack uses lightweight stubs
# (`infra/docker/Dockerfile.sidecar-stub`) so the workers can resolve real
# adapter URLs even without vendor hardware. Replace these with the
# production sidecar URLs once Phase 0 inputs arrive.

# DBLtek GoIP SMS Server v1.30.1 (TZ §21)
DBSMS_BASE_URL=http://dbsms-server
DBSMS_USERNAME=root
DBSMS_PASSWORD=change-me

# go-whatsapp-web-multidevice — WhatsApp pairing via QR over plain HTTP/JSON
# (TZ §1038). This is the primary WhatsApp sidecar in production. Must be
# configured with the same GWMD_USERNAME / GWMD_PASSWORD the sidecar uses
# for HTTP basic auth (set via `--basic-auth` on the gwmd process).
GWMD_BASE_URL=http://gwmd:3000
GWMD_USERNAME=umg
GWMD_PASSWORD=change-me

# UnoAPI Cloud — WhatsApp via Baileys (TZ §23). Legacy, kept optional so
# already-linked endpoints continue to work after the gwmd migration.
UNOAPI_BASE_URL=http://unoapi:9876
UNOAPI_API_KEY=change-me

# signal-cli-rest-api — Signal (TZ §24). Run with MODE=json-rpc per TZ §24.
SIGNAL_BASE_URL=http://signal-cli:8080
SIGNAL_CLI_MODE=json-rpc

# ─── Secrets that MUST be generated per installation ────────────────────────
# Each of these is required by docker-compose.prod.yml and the stack refuses to
# start without them. Generate with: openssl rand -base64 24

# gwmd signs every inbound WhatsApp webhook with HMAC-SHA256 over the raw body
# using this secret; the API rejects anything that does not verify.
GWMD_WEBHOOK_SECRET=change-me

# The DBLtek SMS Server signs nothing, so its forwarding URLs carry this secret
# as a query parameter. Combined with the internal network, it is what keeps
# the inbound SMS route from accepting anything at all.
DBSMS_WEBHOOK_SECRET=change-me

# Database behind the SMS Server. Root is used once, to import the vendor
# schema — the dump creates the database and grants, which the app user cannot.
SMS_DB_ROOT_PASSWORD=change-me
SMS_DB_PASSWORD=change-me

# Host port for the SMS Server's own web UI (add GoIPs and their lines there).
SMS_WEB_PORT=8084

# The SMS Server's forwarding URL is built inside its container from
# DBSMS_WEBHOOK_SECRET, so there is nothing to set here. Override only if the
# API is reachable at some other address:
# UMG_API_URL=http://umg-api:4000
