# Reverse proxy for the whole stack.
#
# The config is baked in rather than bind-mounted. A bind mount of a file from
# the repository looks harmless but does not survive deployment tools that keep
# the checkout somewhere the Docker daemon cannot see: Portainer clones into a
# volume, the daemon resolves the source path on the host, finds nothing,
# creates a directory in its place, and the container dies with "Are you trying
# to mount a directory onto a file". Copying the file removes that whole class
# of failure and makes the stack portable.
FROM nginx:1.27-alpine

COPY nginx-reverse-proxy.conf /etc/nginx/conf.d/default.conf

EXPOSE 8083
