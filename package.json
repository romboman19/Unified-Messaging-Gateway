{
  "name": "umg",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Messaging Gateway — internal SMS, WhatsApp and Signal gateway",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=packages/database",
    "db:migrate": "npm run db:migrate --workspace=packages/database",
    "db:seed": "npm run db:seed --workspace=packages/database",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:worker": "npm run start:dev --workspace=apps/worker"
  }
}
